# Copy this file to .env and fill in your values
MONGODB_URI=mongodb://127.0.0.1:27017/sabun
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sabun?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-secret
PORT=5000

# Customer login OTP (Pinnacle / 1SPOC SMS gateway).
# Required in production — customer checkout requires a verified mobile OTP.
# In local development leave these blank: OTPs are printed in the server console.
# Set SMS_DEV_MODE=true only for local testing. NEVER enable it in production.
# SMS_DEV_MODE=true
SMS_API_URL=https://transapi.pinnacle.in/genericapi/JSONGenericReceiver
SMS_ACCESS_KEY=
# DLT sender header must be EXACTLY 6 characters (operators silently drop others).
SMS_SENDER_ID=
SMS_TYPE=PM
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
# Must exactly match the DLT-approved template for SMS_DLT_TEMPLATE_ID.
# The code is inserted wherever {OTP}, {#var#} or ##OTP## appears.
SMS_OTP_TEMPLATE="Your SaBun login OTP is {OTP}. Valid for 5 minutes."
# Optional extra secret used to hash OTPs (falls back to JWT_SECRET)
# OTP_SECRET=

# Admin account created by `npm run seed` (change these before seeding!)
ADMIN_EMAIL=admin@sabun.local
ADMIN_PASSWORD=change-this-password

# Cloudinary (used by `npm run upload:images`)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

